<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_off">

    <LinearLayout
        android:id="@+id/page_tap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/page_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_power" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="…"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/page_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/nav_prev"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:gravity="center"
        android:text="‹"
        android:textColor="#B3FFFFFF"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/nav_next"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center"
        android:text="›"
        android:textColor="#B3FFFFFF"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dot0"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot1"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot2"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot3"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot4"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot5"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot6"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
        <ImageView
            android:id="@+id/dot7"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_pdot_off" />
    </LinearLayout>
</FrameLayout>
